[node name="ZoomLabel" type="Button" parent="VBox/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
# Reads like a label but is clickable: toggles between 100% and the previous
# zoom level (a quick "actual pixels" preview). All StyleBox states are emptied
# so no background is drawn, even on hover/press.
flat = true
theme_override_styles/normal = SubResource("StyleBoxEmpty_fzcgy")
theme_override_styles/hover = SubResource("StyleBoxEmpty_fzcgy")
theme_override_styles/pressed = SubResource("StyleBoxEmpty_fzcgy")
theme_override_styles/focus = SubResource("StyleBoxEmpty_fzcgy")
theme_override_styles/disabled = SubResource("StyleBoxEmpty_fzcgy")
tooltip_text = "Click to toggle between 100% and previous zoom level"
text = "100%"
mouse_default_cursor_shape = 2

[node name="ZoomInButton" type="Button" parent="VBox/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "+"

[node name="FitButton" type="Button" parent="VBox/Toolbar"]
