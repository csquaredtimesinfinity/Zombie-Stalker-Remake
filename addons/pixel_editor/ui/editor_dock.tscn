[node name="EditorDock" type="Control"]
custom_minimum_size = Vector2(256, 256)
# Clip every descendant to the dock rect so an oversized/overflowing child can
# never be painted outside the panel and bleed over neighbouring editor windows.
clip_contents = true
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_dock")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Toolbar" type="HFlowContainer" parent="VBox"]
# HFlowContainer (not HBoxContainer) so toolbar buttons wrap onto extra rows
# instead of overflowing the panel's right edge when the dock is narrowed.
layout_mode = 2

[node name="NewButton" type="Button" parent="VBox/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "New"

[node name="OpenButton" type="Button" parent="VBox/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "Open"

[node name="SaveButton" type="Button" parent="VBox/Toolbar"]
