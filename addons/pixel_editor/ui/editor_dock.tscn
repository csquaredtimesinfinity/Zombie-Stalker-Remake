[node name="MirrorButton" type="MenuButton" parent="VBox/Toolbar"]
unique_name_in_owner = true
# MenuButton (not OptionButton): the mirror modes are independent toggles, so the
# popup keeps its checkbox items in sync with the canvas state instead of picking
# one exclusive entry.
layout_mode = 2
