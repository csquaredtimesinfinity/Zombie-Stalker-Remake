[node name="Separator" type="VSeparator" parent="VBox/Toolbar"]
layout_mode = 2

# Each mouse-button slot is a self-contained group: its own colour picker + tool
# dropdown. Colours are independent so, e.g., the left slot paints red while the
# right slot paints blue — even when both bind the Pencil. Colour-less tools
# (Eraser) simply ignore the slot's colour.

[node name="Separator2" type="VSeparator" parent="VBox/Toolbar"]
layout_mode = 2

[node name="LeftColorButton" type="ColorPickerButton" parent="VBox/Toolbar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(32, 0)
layout_mode = 2
color = Color(0, 0, 0, 1)
tooltip_text = "Left mouse tool color"

[node name="LeftLabel" type="TextureRect" parent="VBox/Toolbar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(16, 16)
layout_mode = 2
expand_mode = 1
stretch_mode = 5
tooltip_text = "Left mouse button"

[node name="LeftSlot" type="OptionButton" parent="VBox/Toolbar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(24, 0)
fit_to_longest_item = false
layout_mode = 2
tooltip_text = "Tool bound to the left mouse button"

[node name="RightColorButton" type="ColorPickerButton" parent="VBox/Toolbar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(32, 0)
